#!/bin/sh

if [[ $# -eq 1 ]]; then
    delay=$1
else
    # 1 hour in seconds
    delay=$((60*60))
fi

now=$(date "+%D %T:")

echo "$now suspending" >> suspend-then-poweroff.log

start=$(date +%s)
sudo rtcwake -s $delay -m mem
end=$(date +%s)

now=$(date "+%D %T:")

if [ $((end-start)) -ge $delay ]; then
    echo "$now resumed after delay, shutting down" >> suspend-then-poweroff.log
    systemd-run --on-active=5 systemctl poweroff
else
    echo "$now resumed early ($((end-start))s < ${delay}s)" >> suspend-then-poweroff.log
fi
