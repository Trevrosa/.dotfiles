{
    "$schema": "https://raw.githubusercontent.com/Magniquick/waybar-config-schema/main/schema.json",
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    // "width": 1280, // Waybar width
    "reload_style_on_change": true,
    "modules-left": [
        "hyprland/workspaces",
        "network",
        "cpu",
        "memory",
        "temperature",
        "power-profiles-daemon"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "bluetooth",
        "backlight",
        "battery",
        "clock",
        "tray"
        // "custom/lock",
        // "custom/power"
    ],
    "hyprland/workspaces": {
        "format": " {icon} ",
        "format-icons": {
            "default": ""
        }
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        "tooltip": false
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": " ",
            "power-saver": " "
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": " ",
            "deactivated": " "
        },
        "tooltip": false
    },
    "network": {
        "interval": 15,
        "max-length": 26,
        "format-wifi": "{essid} ({signalStrength}%)  ",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected  ",
        "format-alt": "{bandwidthDownBytes}  | {bandwidthUpBytes}  "
    },
    "mpris": {
        "format": "{dynamic}({status})",
        "dynamic-order": [
            "title",
            "artist",
            "position",
            "length"
        ],
        "dynamic-importance-order": [
            "title",
            "position",
            "length",
            "artist"
        ],
        "dynamic-len": 42,
        "interval": 3,
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "default": [
                "",
                "",
                " "
            ]
        },
        "on-click": "pavucontrol"
    },
    "bluetooth": {
        "interval": 30,
        "format-on": " {status}",
        "format-connected": " connected ({device_battery_percentage}%)",
        "tooltip-format": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}: {device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}: {device_battery_percentage}% ({device_address})"
    },
    "backlight": {
        "format": "{percent}% ",
        "tooltip": false
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{}% ",
        "format-plugged": "{}% ",
        "tooltip-format": "Empty in {time} | Drawing {power} W",
        "tooltip-format-charging": "Full in {time} | Charging at {power} W",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        // "format-alt": "{:%d/%m/%Y}",
        "format": "{:%b %d %I:%M %p}"
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "custom/lock": {
        "tooltip": false,
        "on-click": "sh -c '(sleep 0.5s; lock --grace 0)' & disown",
        "format": ""
    },
    "custom/power": {
        "tooltip": false,
        "on-click": "wlogout &",
        "format": "襤"
    }
}
